{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://esp-attandance.onrender.com/api/:path*"
    },
    {
      "source": "/log",
      "destination": "https://esp-attandance.onrender.com/log"
    },
    {
      "source": "/check-unlock",
      "destination": "https://esp-attandance.onrender.com/check-unlock"
    },
    {
      "source": "/health",
      "destination": "https://esp-attandance.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
